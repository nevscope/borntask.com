---
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
}

const { title, description, canonical } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/borntask-logo-120.png" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Sora:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="home">
    <slot />
  </body>
</html>

<style is:global>
  body.home {
    color: var(--surface);
    background: var(--brand);
  }
  .page {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 48px 56px 40px;
    max-width: 880px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--surface);
    text-decoration: none;
  }
  .wordmark {
    font-family: var(--display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.035em;
  }
  .brand svg {
    display: block;
    flex-shrink: 0;
    border-radius: 10px;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.28);
  }
  .app-logo {
    display: block;
    width: 120px;
    height: 120px;
    border-radius: 28px;
    box-shadow: 0 12px 28px rgba(15, 107, 70, 0.28);
  }
  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 28px;
    padding: 48px 0;
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }
  .lede {
    margin: 0;
    max-width: 480px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--brand-on);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 48px;
    padding: 0 22px;
    border-radius: 10px;
    background: var(--surface);
    color: var(--brand-strong);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
  }
  .btn:hover {
    background: var(--brand-on);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 14px;
    font-weight: 500;
  }
  .links a {
    color: var(--brand-on);
    text-decoration: none;
  }
  .links a:hover {
    color: var(--surface);
  }
  footer {
    font-size: 13px;
    color: var(--brand-on-muted);
  }
  @media (max-width: 640px) {
    .page {
      padding: 32px 24px 28px;
    }
  }
</style>
