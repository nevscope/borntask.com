---
import '../styles/tokens.css';
import LogoMark from '../components/LogoMark.astro';

interface Props {
  title: string;
  description: string;
  canonical: string;
  otherHref: string;
  otherLabel: string;
}

const { title, description, canonical, otherHref, otherLabel } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Sora:wght@600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="legal">
    <header>
      <a class="brand" href="/">
        <LogoMark size={22} />
        <span class="wordmark">BornTask</span>
      </a>
      <nav>
        <a href={otherHref}>{otherLabel}</a>
        <a class="muted" href="https://app.borntask.com/">Open app</a>
      </nav>
    </header>
    <main>
      <article>
        <slot />
      </article>
    </main>
  </body>
</html>

<style is:global>
  body.legal {
    background: var(--canvas);
    color: var(--ink);
  }
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding: 18px 28px;
    background: var(--surface);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
  }
  .wordmark {
    font-family: var(--display);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  nav {
    margin-left: auto;
    display: flex;
    gap: 16px;
    font-size: 13.5px;
  }
  nav a {
    color: var(--brand-strong);
    text-decoration: none;
    font-weight: 500;
  }
  nav a.muted {
    color: var(--muted);
    font-weight: 400;
  }
  main {
    padding: 28px 24px 48px;
    display: flex;
    justify-content: center;
  }
  article {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  h1 {
    margin: 0;
    font-family: var(--display);
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .intro {
    margin: 8px 0 0;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.5;
  }
  .meta {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--faint);
  }
  section {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 18px 20px;
  }
  h2 {
    margin: 0 0 10px;
    font-family: var(--display);
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  p,
  li {
    font-size: 14.5px;
    line-height: 1.55;
  }
  p {
    margin: 0 0 10px;
  }
  p:last-child {
    margin-bottom: 0;
  }
  ul {
    margin: 0;
    padding-left: 18px;
  }
  li {
    margin-bottom: 8px;
  }
  a {
    color: var(--brand-strong);
    font-weight: 500;
    text-decoration: none;
  }
</style>
