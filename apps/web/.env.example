# true: every hook reads/writes the in-memory mock in src/api/mockData.ts
# false: hooks call the Fastify API at VITE_API_URL through src/api/http.ts
VITE_USE_MOCKS=true
# Stage 4+: set to false to use the real projects/members/sections API.
VITE_MOCK_PROJECTS=true
# Stage 5+: set to false to use real tasks.
VITE_MOCK_TASKS=true
# After developer sign-in (owner@borntask.com), set both mock flags to false and restart Vite.
# Task hooks fall back to mocks if the API is down.
VITE_API_URL=/api
VITE_MCP_URL=http://localhost:3011/mcp
