# Copy to .env for local development. Never commit .env.

# MySQL (docker compose service "mysql") — port 3308 so kerd can keep 3306
DATABASE_URL="mysql://borntask:borntask@127.0.0.1:3308/borntask"

# Redis — port 6381 so kerd can keep 6379
REDIS_URL="redis://127.0.0.1:6381"

# API
API_HOST=0.0.0.0
API_PORT=3010
API_PUBLIC_URL=http://localhost:3010
PUBLIC_URL=http://localhost:5174
NODE_ENV=development
SESSION_SECRET=borntask-local-dev-session-secret-change-me

# Auth — Stage 2. Without OAuth client secrets, use ALLOW_DEV_LOGIN.
ALLOW_DEV_LOGIN=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

BLOB_ROOT=.data/blobs
MCP_PORT=3011
# Public URL of the MCP server. Chat webhook URLs are encrypted with SESSION_SECRET.
MCP_PUBLIC_URL=http://127.0.0.1:3011

# Transactional email (SendGrid). Leave empty in local dev: the worker prints the invite link and the invite still succeeds.
# Set SENDGRID_API_KEY to your SendGrid API key. From address is BornTask <notify@borntask.com>.
SENDGRID_API_KEY=

# GitHub App (optional). Private key is the PEM, newlines as \n. Do not commit secrets.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
API_INTERNAL_URL=http://127.0.0.1:3010

# Google Chat app (v2, optional). Incoming URL: {API_PUBLIC_URL}/chat/app
# Do not commit real values. Space webhooks work without these.
GOOGLE_CHAT_APP_CLIENT_ID=
GOOGLE_CHAT_APP_CLIENT_SECRET=
GOOGLE_CHAT_APP_VERIFICATION_TOKEN=
# Personal DMs as the Chat app (chat.bot). One-line service account JSON. Never commit it.
# private_key inside the JSON keeps \n escapes. The worker reads this same file.
# Without it, personal events use the saved webhook only.
GOOGLE_CHAT_APP_SERVICE_ACCOUNT_JSON=
# Or, instead of the JSON (PEM newlines as \n):
# GOOGLE_CHAT_APP_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_CHAT_APP_SERVICE_ACCOUNT_PRIVATE_KEY=
