MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

BLOB_ROOT=/data/blobs
SENDGRID_API_KEY=
MCP_PORT=3011
MCP_PUBLIC_URL=https://app.borntask.com/mcp
