COMPOSE_PROJECT_NAME=borntask

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=borntask
MYSQL_USER=borntask
MYSQL_PASSWORD=change-me

PUBLIC_URL=https://app.borntask.com
API_PUBLIC_URL=https://app.borntask.com/api

SESSION_SECRET=generate-a-long-random-string
# Sign-in page is always required. This flag only enables the email/name form until OAuth is live.
ALLOW_DEV_LOGIN=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

BLOB_ROOT=/data/blobs
SENDGRID_API_KEY=
MCP_PORT=3011
MCP_PUBLIC_URL=https://app.borntask.com

# GitHub App. Leave empty until the App is created. Never commit real values.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=
API_INTERNAL_URL=http://127.0.0.1:3010

# Google Chat app (v2). Incoming HTTP: https://app.borntask.com/api/chat/app
# Ops (manual): Google Cloud project, Chat API, app listing, Workspace allowlist.
GOOGLE_CHAT_APP_CLIENT_ID=
GOOGLE_CHAT_APP_CLIENT_SECRET=
GOOGLE_CHAT_APP_VERIFICATION_TOKEN=
# Personal DMs as the Chat app. One-line service account JSON. Never commit it.
# Set on the API and the worker (same env file). Without it, DMs are not sent.
GOOGLE_CHAT_APP_SERVICE_ACCOUNT_JSON=
# Or, instead of the JSON (PEM newlines as \n):
# GOOGLE_CHAT_APP_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_CHAT_APP_SERVICE_ACCOUNT_PRIVATE_KEY=
