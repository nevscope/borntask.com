COMPOSE_PROJECT_NAME=borntask

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=borntask
MYSQL_USER=borntask
MYSQL_PASSWORD=change-me

PUBLIC_URL=https://app.borntask.com
API_PUBLIC_URL=https://app.borntask.com/api

SESSION_SECRET=generate-a-long-random-string
